# FinAlly — environment configuration
# Copy to .env and fill in. .env is gitignored; never commit real keys.
#   cp .env.example .env

# --- AI assistant (OpenRouter) -------------------------------------------
# Get a key at https://openrouter.ai/keys. Leave as REPLACE_ME (or empty) to
# run the assistant in deterministic mock mode with no network calls.
OPENROUTER_API_KEY=REPLACE_ME

# Model id. MUST end in ":free" while OPENROUTER_FREE_ONLY is true.
# Default chosen by benchmark: fastest free model that did not hallucinate
# trades on read-only prompts (4/4 correct, avg 3.6s).
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# Spend guard. true = refuse to call any model whose id does not end in
# ":free", falling back to mock mode with a loud warning instead of spending.
OPENROUTER_FREE_ONLY=true

# Seconds before a slow model is abandoned. Free-tier latency is erratic
# (measured 1.2s-20.5s, with one probe queuing over 10 minutes).
OPENROUTER_TIMEOUT=30

# Comma-separated OpenRouter provider preference. Empty = let OpenRouter route.
# Set to "cerebras" to restore the PLAN.md §9 behaviour (requires a paid model,
# so also set OPENROUTER_FREE_ONLY=false).
OPENROUTER_PROVIDER_ORDER=

# Reasoning effort passed to the model. Unsupported by most free models and
# dropped automatically when rejected.
OPENROUTER_REASONING_EFFORT=low

# --- Market data ----------------------------------------------------------
# Optional Massive (Polygon.io) key for real market data. LEAVE EMPTY to use
# the built-in GBM simulator — recommended: it ticks every 500ms and works
# outside market hours, so the UI is alive during a demo.
MASSIVE_API_KEY=

# --- Behaviour ------------------------------------------------------------
# true = deterministic mock LLM responses, no network. Used by the E2E suite.
LLM_MOCK=false

# SQLite file. Relative paths resolve against the project root.
# Docker overrides this to /app/db/finally.db (the volume mount).
FINALLY_DB_PATH=db/finally.db

# true = allow CORS from http://localhost:3000 for local frontend dev
# (cd frontend && NEXT_PUBLIC_API_BASE=http://localhost:8000 npm run dev).
DEV_CORS=false
